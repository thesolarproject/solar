<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="Solar Quick Menu" android:allowBackup="false">
        <service
            android:name=".QuickMenuService"
            android:exported="true" />
        <receiver
            android:name=".QuickMenuReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.solar.quickmenu.SHOW" />
                <action android:name="com.solar.quickmenu.DISMISS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
