#!/system/bin/sh
# Solar Y1 boot tweaks (formerly a Rockbox button handoff daemon).

BOOT_COMPLETED=0
while [ "$BOOT_COMPLETED" -ne 1 ]; do
    BOOT_COMPLETED=$(getprop sys.boot_completed)
    sleep 1
done

# Y1 speaker is driven by the hardware codec; Android UI sounds double up.
settings put system sound_effects_enabled 0
